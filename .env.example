# URL pública de la app (usada por metadataBase para OG/Twitter absolutos)
NEXT_PUBLIC_APP_URL=https://tu-dominio.vercel.app

# API key opcional de MyMemory (fallback de traducción cuando Google Translate falla)
MYMEMORY_API_KEY=

# Webhook que recibe los leads del formulario de /registro (Google Apps Script → Sheets)
# Sin esta variable, /api/leads responde OK pero no persiste nada (solo dev)
LEADS_WEBHOOK_URL=
